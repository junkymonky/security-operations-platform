# PostgreSQL (Neon) connection string used by the Next.js app and the ML service
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Identity shown in the console (there is no auth/users table yet)
ANALYST_NAME=Your Name
ANALYST_ROLE=Security analyst
ORG_NAME=Your organisation
# Where the Python ML service runs (proxied at /ml-api)
ML_API_URL=http://127.0.0.1:8000
