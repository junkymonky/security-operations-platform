# PostgreSQL connection string (same Neon database used by the Next.js app).
# If unset, the service falls back to DATABASE_URL in ../.env.local.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Directory for uploaded datasets and serialized models
ML_STORAGE_DIR=./storage
# Upload limits
MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=200
# Comma-separated origins allowed to call the API directly (the Next.js proxy needs none)
CORS_ORIGINS=http://localhost:3000
# DB transport: auto (default) tries Postgres TCP 5432 and falls back to Neon SQL-over-HTTPS (443)
# when the port is blocked; force with tcp or http
DB_DRIVER=auto
